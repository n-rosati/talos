{
    "enabled": true,
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":timezone(America/Toronto)",
        ":disableRateLimiting",
        ":semanticCommits",
        ":configMigration",
        "helpers:pinGitHubActionDigests",
        "github>n-rosati/talos//.github/renovate/kinds.json5",
        "github>n-rosati/talos//.github/renovate/labels.json5",
        "github>n-rosati/talos//.github/renovate/automerge.json5",
        "github>n-rosati/talos//.github/renovate/commitMessages.json5"
    ],
    "pre-commit": {
        "enabled": true
    },
    "ignorePaths": [
        "**/*.sops.*",
        "**/.archive/**",
        "**/archive/**",
        "**/resources/**"
    ]
}