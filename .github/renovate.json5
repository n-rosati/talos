{
    "enabled": true,
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":timezone(America/Toronto)",
        ":disableRateLimiting",
        ":semanticCommits",
        ":configMigration",
        "helpers:pinGitHubActionDigests",
        "github>n-rosati/talos//.github/renovate/kinds.json5",
        "github>n-rosati/talos//.github/renovate/labels.json5",
        "github>n-rosati/talos//.github/renovate/automerge.json5"
        
        // "github>alfi0812/talos//.github/renovate/customManagers.json5",
        // "github>alfi0812/talos//.github/renovate/kinds.json5",
        // "github>alfi0812/talos//.github/renovate/semanticCommits.json5",
        // "github>alfi0812/talos//.github/renovate/labels.json5",
        // "github>alfi0812/talos//.github/renovate/autoMerge.json5",
        // "github>alfi0812/talos//.github/renovate/groups.json5",
        // "github>alfi0812/talos//.github/renovate/special_grafanadashboard.json5",
        // "github>alfi0812/talos//.github/renovate/special_truechartsSchema.json5"
        
        // "github>Boemeltrein/TalosCluster//.github/renovate/customManagers.json5",
        // "github>Boemeltrein/TalosCluster//.github/renovate/kinds.json5",
        // "github>Boemeltrein/TalosCluster//.github/renovate/semanticCommits.json5",
        // "github>Boemeltrein/TalosCluster//.github/renovate/labels.json5",
        // "github>Boemeltrein/TalosCluster//.github/renovate/autoMerge.json5",
        // "github>Boemeltrein/TalosCluster//.github/renovate/groups.json5",
        // "github>Boemeltrein/TalosCluster//.github/renovate/grafanaDashboards.json5"
    ],
    "pre-commit": {
        "enabled": true
    },
    "ignorePaths": [
        "**/*.sops.*",
        "**/.archive/**",
        "**/archive/**",
        "**/resources/**"
    ]
}