{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "ClusterTool Cluster",
  "image": "oci.trueforge.org/containerforge/devcontainer:4.1.1@sha256:2be86fdd9ba4736be6eb9b94125776c0077f2a4f706ab97468b2a11c9d8ac88a",
  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
  "updateRemoteUserUID": false,
  "runArgs": ["--privileged"],
  "containerEnv": {
    "TALOSCONFIG": "/workspaces/talos/clusters/main/talos/generated/talosconfig",
    "KUBECONFIG": "/workspaces/talos/clusters/main/talos/generated/kubeconfig"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mitchdenny.ecdc",
        "signageos.signageos-vscode-sops",
        "usernamehw.errorlens",
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "sandipchitale.vscode-kubernetes-helm-extras",
        "Tim-Koehler.helm-intellisense",
        "VadzimNestsiarenka.helm-template-preview-and-more",
        "karyan40024.helmix",
        "albert.TabOut",
        "weaveworks.vscode-gitops-tools",
        "blueglassblock.better-json5"
      ]
    }
  }
}
